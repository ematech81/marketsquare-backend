NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/squaremarket?appName=squaremarket
JWT_SECRET=generate-a-long-random-string
# Storefront and dashboard origins, comma separated
CLIENT_URL=http://localhost:3000,http://localhost:3001

# KoraPay (payments phase)
KORAPAY_PUBLIC_KEY=
KORAPAY_SECRET_KEY=
# 3-4 letters, unique across your apps on the shared webhook router
KORAPAY_PREFIX=SQM
KORAPAY_CURRENCY=NGN
# Must match the router's ROUTER_FORWARD_SECRET. Leave empty to skip that check.
ROUTER_FORWARD_SECRET=
# Where customers return after paying
WEB_URL=http://localhost:3000

# Cloudinary (product images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email through Brevo's HTTP API (recommended). The sender address must be verified in Brevo.
BREVO_API_KEY=
MAIL_FROM=Square Market <you@yourdomain.com>
# Or, instead of Brevo, any SMTP server: SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS
# Where new-order alerts go (your own email and phone)
ADMIN_ALERT_EMAIL=
ADMIN_ALERT_PHONE=

# SMS through BulkSMS Nigeria. The sender ID must be registered to YOU (customers see it).
SMS_PROVIDER=bulksms
BULKSMS_BASE_URL=https://www.bulksmsnigeria.com/api/v2
BULKSMS_API_TOKEN=
BULKSMS_SENDER_ID=

# Store rules (Naira and days)
MIN_ORDER_AMOUNT=30000
RETURN_DAYS=30
