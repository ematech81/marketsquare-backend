NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/squaremarket?appName=squaremarket
JWT_SECRET=generate-a-long-random-string
# Storefront and dashboard origins, comma separated
CLIENT_URL=http://localhost:3000,http://localhost:3001

# KoraPay (payments phase)
KORAPAY_PUBLIC_KEY=
KORAPAY_SECRET_KEY=
# 3-4 letters, unique across your apps on the shared webhook router
KORAPAY_PREFIX=SQM
KORAPAY_CURRENCY=NGN
# Must match the router's ROUTER_FORWARD_SECRET. Leave empty to skip that check.
ROUTER_FORWARD_SECRET=
# Where customers return after paying
WEB_URL=http://localhost:3000

# Cloudinary (product images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (any provider that offers SMTP: Brevo, Resend, Gmail, Zoho...). Leave SMTP_HOST empty to skip emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Square Market <no-reply@yourdomain.com>
# Where new-order alerts go (your own email)
ADMIN_ALERT_EMAIL=
